# TeleVent — crons système (OVH VPS). Source de vérité VERSIONNÉE.
# Installé automatiquement dans /etc/cron.d/televent par deploy/scripts/deploy.sh.
# Prérequis : /usr/local/bin/televent-cron-call (posé par deploy.sh) et
#             CRON_SECRET défini dans /srv/televent/app/.env.
# Les routes re-vérifient elles-mêmes le secret (isCronAuthorized).
#
# NB : ce crontab est l'UNIQUE ordonnanceur. Le workflow GitHub Actions
# (.github/workflows/sap-sync.yml) qui appelait /api/cron/sap-sync a été
# SUPPRIMÉ : son secret n'a jamais existé côté GitHub (tous ses runs échouaient)
# et il ferait doublon ici. Ne pas le recréer.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""

# ── Ventes / documents SAP (factures, commandes, BL, réceptions) = RÉSULTATS DU
#    MOIS EN COURS. Toutes les 10 min. ──
0,10,20,30,40,50 * * * *  televent  televent-cron-call /api/sap/sync/mirror

# ── Stock SAP incrémental (léger) — toutes les 10 min, décalé de 5 min du miroir
#    pour ne pas cogner le pooler en même temps. ──
5,15,25,35,45,55 * * * *  televent  televent-cron-call /api/sap/sync/delta

# ── Rafraîchissement du stock inventaire (vue locale) — toutes les 15 min, décalé. ──
3,18,33,48 * * * *  televent  televent-cron-call /api/inventaire/refresh-stock

# ── Catalogue produits + stock COMPLET (plus lourd) — 2×/h, minutes creuses. ──
23,53 * * * *  televent  televent-cron-call /api/sap/sync/products

# ── Retour automatique des bascules vendeur temporaires (congés) arrivées à
#    échéance : chaque matin, les clients reviennent à leur titulaire. ──
20 3 * * *  televent  televent-cron-call /api/vendeur-reassign/revert

# ── Taux d'intérêt légal (Banque de France, série IFRLEGAL_PROF) : rafraîchi
#    1×/jour. Ne change que 2×/an ; le calcul de pénalités le rafraîchit aussi
#    de façon paresseuse — ce cron garantit juste sa présence en base. ──
40 4 * * *  televent  televent-cron-call /api/cron/legal-rate

# ── Archive des documents : récupère les PDF (BL/avoirs/factures) de la boîte
#    partagée factures-archive@ et les indexe. No-op tant que l'archive n'est pas
#    activée (Paramètres) / Mail.Read non accordée. Toutes les 30 min. ──
7,37 * * * *  televent  televent-cron-call /api/cron/archive-sync

# ── Chaînage des documents (BL → Facture → Avoir) : pré-calcule les pivots de
#    dossier pour un « dossier lié » local instantané. Toutes les 15 min. ──
12,27,42,57 * * * *  televent  televent-cron-call /api/cron/archive-link

# ── Rafraîchissement QUOTIDIEN de la base clients depuis SAP (upsert, jamais de
#    vidage). Chaque matin à 4h05. ──
5 4 * * *  televent  televent-cron-call /api/sap/clients/import

# ── Sauvegarde PostgreSQL locale (inoffensif si la base n'est pas locale :
#    le script sort immédiatement). ──
15 2 * * *  televent  /srv/televent/app/deploy/scripts/backup-db.sh
